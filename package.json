{
  "name": "streamgrab",
  "version": "1.2.0",
  "description": "Cross-browser extension that detects HLS/DASH/blob-backed videos and downloads them as a single playable MP4 (audio + video), without having to play them.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "fixtures": "bash tests/make-fixtures.sh",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "pack": "node scripts/build.mjs --zip",
    "check": "npm run build && npm test && npm run lint:firefox && npm run test:gallery && npm run test:ui && npm run test:e2e",
    "fixtures:long": "bash tests/make-long-fixture.sh",
    "screenshots": "SCREENSHOTS=1 node tests/e2e/ui-gallery.mjs && SCREENSHOTS=1 node tests/e2e/run.mjs",
    "test:ui": "node tests/e2e/ui-tabs.mjs",
    "test:gallery": "node tests/e2e/ui-gallery.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "mux.js": "^7.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.4",
    "puppeteer-core": "^25.16.0",
    "web-ext": "^10.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1se0/StreamGrab.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "video-downloader",
    "hls",
    "dash",
    "m3u8",
    "mpd",
    "blob",
    "webextension",
    "chrome-extension",
    "firefox-addon",
    "mp4"
  ]
}